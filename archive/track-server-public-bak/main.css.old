.now-racing h1, .on-deck h1 {
  background: #37474f;
  color: white;
  border-bottom: solid 1px black;

  margin-top: 0;
  margin-bottom: 0;
  padding-top: 20px;
  padding-bottom: 20px;
}

.on-deck h1 {
  background: #white;
}

.results-pane {
  overflow: scroll;
  height: 100%;
}

.results-pane .list-item {
  display:block;
}


.name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.name h2 {
  margin: 1.4em auto;
  text-overflow: ellipsis;
  overflow:hidden;
}

.result-name {
  max-width: 170px;
  left:5px;
  top:0;
  position:absolute;
}

.lane-result-container {
  box-shadow: 2px 2px 3px 1px rgba(0,0,0,0.5);
}

.lane-result {
  position:relative;
  border:solid black 1px; 
  font-size:20pt;
  padding:0 10px;
  height:38px;
  background:white;
}

.lane-result:not(:first-child) {
  border-top:none;
}

.results-pane ul {
  padding: 0;
  font-size: 16pt;
}
.result-time {
  right:5px;
  top:0;
  position:absolute;
  color:yellow;
/*
  position: relative;
  top:-35px;
  left:6px;
  */
  font-size:20pt;
  text-align:left;
  font-style: italic;
  font-weight: 600;
  
  text-shadow:
      1px  0px 0px black,
     -1px  0px 0px black,
      0px  1px 0px black,
      0px -1px 0px black,
      1px  1px 0px black,
      1px -1px 0px black,
     -1px  1px 0px black,
     -1px -1px 0px black,
      2px  0px 0px black,
     -2px  0px 0px black,
      0px  2px 0px black,
      0px -2px 0px black,
      2px 2px 1px black;

}

.time-countdown, .time-final {
  color:white;
  position: relative;
  top: -32px;
  line-height: 0;
  left: 16px;
  font-size: 40pt;
  text-align: left;
  font-style: italic;
  font-weight: 600;
  text-shadow:
     3px  3px 1px black,
    -2px -2px 0px black,
     2px -2px 0px black,
    -2px  2px 0px black,
    2px 0px 0px black,
    -2px 0px 0px black,
    0px 2px 0px black,
    0px -2px 0px black;
}

.result-place {
  color:yellow;
  position: relative;
  top:-140px;
  line-height:0;
  left:6px;
  font-size:100px;
  text-align:left;
  font-style: italic;
  font-weight: 600;
 
  text-shadow:
      1px  0px 0px black,
     -1px  0px 0px black,
      0px  1px 0px black,
      0px -1px 0px black,
      1px  1px 0px black,
      1px -1px 0px black,
     -1px  1px 0px black,
     -1px -1px 0px black,
      2px  0px 0px black,
     -2px  0px 0px black,
      0px  2px 0px black,
      0px -2px 0px black,
      2px 2px 1px black;

}

.result-place-show {
  animation: pulsescale;
  animation-timing-function: cubic-bezier(.57,2.5,.62,1);
  animation-duration: 0.5s;
  transform-origin: 30px 30px;
}

@keyframes pulsescale {
  0% {
    transform: scale(0.0);
    
    opacity: 0;
  }
  
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.time-countdown-fade {
  animation: fadeout;
  animation-duration:1s;
  animation-fill-mode: both;
}

@keyframes fadeout {
  from {
    opacity: 1;
    transform: scale(1);
  }
  
  to {
    opacity: 0;
    transform: scale(1.1);
  }
}

.time-final {
  font-weight: bold;
  color: yellow;
}



.ng-enter {
  /*-webkit-transition:  opacity 1s, margin-bottom 0.25s, margin-left .5s;
  transition: opacity 1s, margin-bottom 0.25s, margin-left .5s;*/
  /*-webkit-transition: opacity 1s, margin-bottom 0.25s, transform 0.25s;
  transition: opacity 1s, margin-bottom 0.25s, transform 0.25s;
  */
  
  animation-duration: 1s;
  animation-name: slidein;
  
  margin-bottom: -192px;
  transform: translate(-200px, 192px);
  /*margin-left: -200px;
  margin-right: 200px;*/
  opacity:0;
}

.ng-enter-active {
transform: translate(0px, 0);
  /*margin-left: 0px;
  margin-right: 0px;*/
  margin-bottom: 0px;
  opacity:1;

}

/* Trick to center the date */
.result-date {
  margin: 0 auto;
  margin-top:10px;
  width: 40%;
}

@keyframes slidein {
  0% {
    transform: translate(-200px, 192px);
    margin-bottom: -192px;
    opacity: 0;
  }
  
  50% {
    transform: translate(-200px, 0);
    margin-bottom: 0;
    opacity: 0;
  }
  
  
  100% {
    transform: translate(0px, 0px);
    margin-bottom: 0;
    opacity: 1;
  }
}

.animateRacing {
  animation: slideoutRacing;
  animation-duration: 0.4s;
  animation-timing-function: ease-in;
  -webkit-animation-fill-mode: both;
}


@keyframes slideoutRacing {
  0% {
    transform: translate(0, 0);
    opacity: 1;
  }
  
  100% {
    transform: translate(600px, 0) scale(0.8);
    opacity: 0;
  }
}

.animateOnDeckMoveUp {
  animation: slideupOnDeck;
  animation-duration: 0.5s;
  -webkit-animation-fill-mode: both;
}

@keyframes slideupOnDeck {
  0% {
    transform-origin: 0 0;
    transform: translate(0, 0) scale(0.6667);
    background: #ddd;
  }
  
  100% {
    transform-origin: 0 0;
    transform: translate(0, -515px) scale(1);
    background: linear-gradient(to right,
    #90caf9 0%,
    #90caf9 25%,
    #ffeb3b 25%,
    #ffeb3b 50%,
    #8bc34a 50%,
    #8bc34a 75%,
    #e57373 75%,
    #e57373 100%);
  }
}

@keyframes slideupOnDeckNarrow {
  0% {
    transform-origin: 50% 0;
    transform: translate(0, 0) scale(0.9);
    background: #ddd;
  }
  
  100% {
    transform-origin: 50% 0;
    transform: translate(0, -379px) scale(1);    
    background: linear-gradient(to right,
    #90caf9 0%,
    #90caf9 25%,
    #ffeb3b 25%,
    #ffeb3b 50%,
    #8bc34a 50%,
    #8bc34a 75%,
    #e57373 75%,
    #e57373 100%);
  }
}

.animateOnDeckAppear {
  animation: fadeinOnDeck;
  animation-duration: 0.6s;
  -webkit-animation-fill-mode: both;
}

@keyframes fadeinOnDeck {
  0% {
    opacity: 0;
  }
  
  100% {
    opacity: 1;
  }
}

.nowRacingImg {
  animation: pulseBorder;
  animation-duration: 1.0s;
  animation-iteration-count: infinite;
  animation-direction: alternate;
  animation-timing-function: ease-in-out;
}

@keyframes pulseBorder {
  0% {
    outline: solid rgba(0,200,0,0) 6px;
  }
  
  100% {
    outline: solid rgba(0,200,0,1) 6px;
  }
}

 .qr-code-container h2.narrow {
    display:none;
  }
  

@media (max-width: 1400px) {
  
  .time-countdown,
  .time-final {
    font-size: 36pt;
  }
  
  .result-date {
    width: 100%;
  }
  
  .on-deck {
    transform: scale(0.9);
    /* transform: scale(0.1); */
    transform-origin: 50% 0;
  }
  
  .qr-code-container {
    position: relative;
    float: left;
    width:100%; 
    margin-left: 15px;
    margin-top: 0px;
  }
  
  .qr-code-container h2 {
    /* display: inline-block; */
  }
  
  .qr-code-container img {
    display: inline-block;
    margin: 0;
  }
  
  .qr-code {
    float:right;
    margin:30px;
    margin-right:160px;
    width:128px;
    height:128px;
  }
  
  .qr-code-container h2.wide {
    display:none;
  }
  
   .qr-code-container h2.narrow {
    display:block;
    margin-top:50px;
  }
  
  
  .result-place {
    top:-110px;
    line-height:0;
    left:6px;
    font-size:100px;
  }
  
  .animateOnDeckMoveUp {
    animation: slideupOnDeckNarrow;
    animation-duration: 0.5s;
    -webkit-animation-fill-mode: both;
  }
  
}

.race-footer {
  font-size:22pt;
}

#instant-replay {
  /* display: none; */
  position: fixed;
  transform: scale(0.95);
  opacity: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  
  transition: opacity 1s, transform 1s;
  background: black;
}

#instant-replay.shown {
  /* display: block; */
  transform: scale(1.0);
  opacity: 1;
}

.instant-replay-results {
  font-size: 30pt;
  color: yellow;
}

.lane-color-1 {
  color: #90caf9;
}

.lane-color-2 {
  color: #ffeb3b;
}

.lane-color-3 {
  color: #8bc34a;
}

.lane-color-4 {
  color: #e57373;
}