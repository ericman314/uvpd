input {
  background-color: rgba(0, 0, 0, 0.5);
  border: #777 solid 2px;
  color:white;
  font-size: 14pt;
  text-align:center;
}
	*/	
  
body.x-hide-overflow {
  overflow:hidden;
}
  
.fullpage {
  position: fixed;
  top:0;
  left:0;
  bottom:0;
  right:0;
  background: #f7f0e0;
  text-align:center;
  height:100%;
  max-width:1280px;
}

hr {
  border-top:solid 1px #aaa;
  border-bottom:solid 1px #fff7f7;
  
}

* {
  font-family: 'Exo 2', sans-serif;
  font-weight: 600;
}

.result-time,
.time-countdown, 
.time-final,
.result-place {
 font-family: 'Exo 2', sans-serif;
 font-style: italic;
 font-weight: 600;
}

.now-racing {
  padding: 0;
  padding-bottom: 15px;
  margin-top:15px;
  /*border: solid 10px #ddd;*/
  border: solid 1px black;
  box-shadow: 2px 2px 3px 1px rgba(0,0,0,0.5);
  background: linear-gradient(to right,
    #90caf9 0%,
    #90caf9 25%,
    #ffeb3b 25%,
    #ffeb3b 50%,
    #8bc34a 50%,
    #8bc34a 75%,
    #e57373 75%,
    #e57373 100%);
  }
  
  
.on-deck {
  transform-origin: 0 0;
  transform: scale(0.6667);
  padding: 0;
  padding-bottom: 15px;
  margin-top:20px;
  /*border: solid 10px #ddd;*/
  border: solid 1px black;
  box-shadow: 2px 2px 3px 1px rgba(0,0,0,0.5);
  background: #ddd;
}
  
.qr-code-container {
  z-index:-1;
  position:absolute; 
  width: 30%; 
  right: 15px; 
  top: 52.8%; 
  bottom:15px; 
  background:white; 
  border: solid black 1px;
  box-shadow: 2px 2px 3px 1px rgba(0,0,0,0.5);
}

.qr-code-container img {
  margin: 28px auto;
}

