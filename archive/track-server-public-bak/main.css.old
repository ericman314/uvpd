@font-face {
  font-family: 'Lato';
  font-style: normal;
  font-weight: 300;
  src: local('Lato Light'), local('Lato-Light'), url(https://fonts.gstatic.com/s/lato/v11/nj47mAZe0mYUIySgfn0wpQ.ttf) format('truetype');
}
@font-face {
  font-family: 'Lato';
  font-style: normal;
  font-weight: 400;
  src: local('Lato Regular'), local('Lato-Regular'), url(https://fonts.gstatic.com/s/lato/v11/v0SdcGFAl2aezM9Vq_aFTQ.ttf) format('truetype');
}
@font-face {
  font-family: 'Lato';
  font-style: normal;
  font-weight: 700;
  src: local('Lato Bold'), local('Lato-Bold'), url(https://fonts.gstatic.com/s/lato/v11/DvlFBScY1r-FMtZSYIYoYw.ttf) format('truetype');
}


body, html {
	padding: 0;
	margin: 0;
	font-family: 'Lato', sans-serif;
	
	background: #f7f0e0;
}

p:not(.help-block) {
  font-size: 14pt;
}

.bigbig {
  font-size:300%;
}

b {
  color:black;
}

body.home {
  background: none;
}

.overweight {
  color: #a00;
}

.header {
	/*background: #44332d;*/
	padding-top: 18px;
	padding-bottom: 12px;
	text-align: center;
	background-image: url("background-header.jpg");
	font-size: 12pt;
}

.logo {
	margin: 0 auto;
	display: block;
}

.nav {
	margin: 0 auto;
}

.nav ul {
	text-align: center;
	padding: 0;
	margin: 0;
	margin-top:15px;
}

.nav li {
	display: inline-block;
	margin: 0 20px;
	color:#dcb;
	font-size: 16pt;
}



.nav a {
	color:#dcb;
	text-decoration: none;
}

.nav a:hover {
	color:#dcb;
	text-decoration: underline;
}

@media (max-width: 500px) {
  .nav {
    line-height: 250%;
  }
  .nav li {
    display:block;
  }
}

@media (min-width: 501px) {
  .nav li:not(:first-child):before {
    position: relative;
    left: -20px;
    content: '|';
  }
}

.subtitle {
	margin-top: 1em;
	color: #cba;
	font-weight: 300;
}

.pageContent {
	max-width: 900px;
	margin: 0 auto;
  background: rgb(247,240,224);
}

.pageContent-home {
  max-width: 500px;
  margin: 0 auto;
  background: rgba(247,240,224,.7);
  padding: 0 20px;
}

img {
	max-width: 100%;
}

.center {
	text-align: center;
}

.big {
	font-size: 125%;
}

.small {
	font-size: 85%;
}

.caption {
	font-size: 75%;
	font-weight: 300;
}

.name {
  color: #333;
}

.name:hover, .name:focus {
  text-decoration:none !important;
  color: #333 !important;
}

a, a:focus {
	color: #a50;
	text-decoration:none;
}

a:hover {
	color: #c70;
	text-decoration:underline;
}

input[type=submit],
a.button,
.btn-primary:not(.dropdown-toggle) {
	background: #AD431F !important;
/*	padding: 8px;*/
	color:#fff7f0;
	font-weight: 300;
	font-size: 110%;
	border: none !important;
}

.btn-primary {
  background: #AD431F !important;
}

.btn-primary:hover {
  background:#e05520 !important;
}

input[type=submit]:hover:not(:disabled),
a.button:hover,
.btn-primary:not(.dropdown-toggle):hover:not(:disabled) {
	color:white;
	background:#e05520 !important;
	text-decoration:none;
  cursor:pointer;
}

ul.features {
	text-align:center;
	margin: 20px auto;
	-webkit-columns:2;
       -moz-columns:2;
            columns:2;
	font-weight: 300;
	max-width: 600px;
	list-style:none;
	padding: 0;
	font-size: 13pt;
}

ul.features li {
	margin-bottom: 18px;
	
}

.standout {
	width: 80%;
	margin: 0 auto;
	font-size: 100%;
	background: #605047;
	padding: 20px;
	font-weight:300;
	color:#f7f0e0;
/*	border: solid #db9981 7px;*/
}

label, input.form-control {
	font-family: Lato;
	font-size: 16pt;
}

[ng\:cloak], [ng-cloak], [data-ng-cloak], [x-ng-cloak], .ng-cloak, .x-ng-cloak {
  display: none !important;
}
  
table {
  width: 100%;
  font-weight: 400;
  border-collapse: collapse;
}

tr.rowheading td {
  font-weight: 700;
  border-bottom: solid gray 1px;
}

.board {
  background: #d3c7ba;
  padding: 8px;
  margin-bottom: 32px;
}

.boardHeading {
  text-align:left;
  padding: 12px 0;
  background: #d3c7ba;
  font-weight: 400;
  color:black;
  border-bottom: solid gray 1px;
}

@media (max-width:600px) {
  .showWide {
    display:none;
  }
  
  .resultsRow:not(:last-child) {
    border-bottom:solid gray 1px;
  }
}

@media (min-width:601px) {
  .showNarrow {
    display:none;
  }
}

table.results {
  color:black;
  font-size: 80%;
}

table.results td {
  text-align:left;
}
